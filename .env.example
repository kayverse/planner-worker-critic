# Copy this file to a new file named .env  (same folder) and fill in your real key.
# .env is ignored by Git, so your key is never uploaded.
LLM_API_KEY=paste-your-key-here
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL=gemini-3.1-flash-lite
DELAY=6
TEMPERATURE=0
# Optional: only if you want a dollar estimate (price per 1 million tokens)
# PRICE_IN=0
# PRICE_OUT=0
